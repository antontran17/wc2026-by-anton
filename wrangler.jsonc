{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wc2026-by-anton",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/get/*", "/health"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
