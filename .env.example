# Example Environment Configuration
# Copy this file to .env.development or .env.production and fill in your values
# NEVER commit real credentials to git!

NODE_ENV=development

# Server
PORT=3050
API_URL=http://localhost:3050
FRONTEND_URL=http://localhost:3050

# Database
# For production with auth: mongodb://username:password@host:port/dbname?authSource=admin
MONGODB_URL=mongodb://localhost:27017/worldcup2026

# Security - Generate strong random keys for production!
JWT_SECRET=your_jwt_secret_key_here
SECRET=your_secret_key_here
ACESSCODEDEV=your_admin_access_code

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# Swagger Documentation (true/false - always enabled in development)
ENABLE_SWAGGER=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX=300

# CORS (use * for development, specific origins for production)
CORS_ORIGINS=*

# Optional Render keep-alive self ping. Set KEEP_ALIVE_URL to your Render health URL.
KEEP_ALIVE_URL=https://your-render-service.onrender.com/health
KEEP_ALIVE_INTERVAL_MS=600000

# API-Football / API-Sports (https://www.api-football.com/)
# Required for live World Cup 2026 fixtures, scores, and match status.
# Keep the real key only in .env / Render Environment, never commit it.
APIFOOTBALL_KEY=your_api_football_key
APIFOOTBALL_LEAGUE=1
APIFOOTBALL_SEASON=2026

# football-data.org fallback (https://www.football-data.org/)
FOOTBALL_DATA_TOKEN=your_football_data_token
FOOTBALL_DATA_COMPETITION=WC
FOOTBALL_DATA_SEASON=2026
FOOTBALL_DATA_LIVE_TTL_MS=30000
FOOTBALL_DATA_MATCHDAY_TTL_MS=300000
FOOTBALL_DATA_IDLE_TTL_MS=21600000

# NOWPayments - Crypto Payment Gateway (https://nowpayments.io)
# Get your API keys from: https://account.nowpayments.io/
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_PUBLIC_KEY=your_nowpayments_public_key
DONATION_WALLET_ADDRESS=your_trc20_wallet_address
